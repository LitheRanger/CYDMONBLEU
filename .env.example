# Configuración de Base de Datos MySQL
# Poner DISABLE_DB=true para desactivar temporalmente la DB (por ejemplo en Render)
DISABLE_DB=false
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=tu_password
DB_NAME=monbleu_returns
DB_PORT=3306

# Configuración de Stripe
STRIPE_SECRET_KEY=sk_test_tu_secret_key_aqui
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret_aqui

# Configuración de FedEx (para generar guías)
# FEDEX_ENV puede ser sandbox o production
FEDEX_ENV=sandbox
FEDEX_CLIENT_ID=tu_fedex_client_id
FEDEX_CLIENT_SECRET=tu_fedex_client_secret
FEDEX_ACCOUNT_NUMBER=tu_fedex_account_number
FEDEX_SERVICE_TYPE=FEDEX_GROUND
FEDEX_LABEL_IMAGE_TYPE=PDF
FEDEX_PKG_WEIGHT=1
FEDEX_PKG_WEIGHT_UNIT=LB
FEDEX_PKG_LENGTH=10
FEDEX_PKG_WIDTH=10
FEDEX_PKG_HEIGHT=10
FEDEX_PKG_DIM_UNIT=IN

# Dirección de devolución (tu almacén)
RETURN_COMPANY_NAME=Monbleu
RETURN_CONTACT_NAME=Logistica
RETURN_PHONE=0000000000
RETURN_ADDRESS1=Tu Calle 123
RETURN_ADDRESS2=
RETURN_CITY=Ciudad
RETURN_STATE=Estado
RETURN_POSTAL_CODE=00000
RETURN_COUNTRY_CODE=MX

# Fallback de teléfono del cliente (si la orden no tiene teléfono)
DEFAULT_CUSTOMER_PHONE=0000000000

# Puerto del servidor
PORT=3000

# Acceso al panel admin (BASIC AUTH)
ADMIN_USER=Monbleu
ADMIN_PASS=123456

# Configuración de Shopify (si aplica)
# Nota: SHOPIFY_SHOP es el subdominio de la tienda (sin .myshopify.com)
SHOPIFY_CLIENT_ID=tu_api_key_aqui
SHOPIFY_CLIENT_SECRET=tu_secret_key_aqui
SHOPIFY_SHOP=tu-tienda
